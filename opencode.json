{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "mcp": {
    "modern-web-guidance": {
      "type": "remote",
      "url": "https://modern-web-guidance.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GOOGLE_API_KEY}"
      }
    },
    "database-toolbox": {
      "type": "remote",
      "url": "https://database-toolbox.googleapis.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "figma-design-sync": {
      "type": "remote",
      "url": "https://figma-mcp.example.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "plugin": [],
  "formatter": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
