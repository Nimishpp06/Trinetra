{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ],
  "functions": {
    "api/*.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "buildCommand": "pip install -r api/requirements.txt",
  "outputDirectory": "frontend"
}